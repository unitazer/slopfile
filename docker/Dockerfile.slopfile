FROM rust:1-slim AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release

FROM archlinux:base-devel
ENV RUSTUP_HOME=/usr/lib/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}
RUN pacman-key --init && \
    pacman -Syu --noconfirm --needed rustup python sudo git curl lua53 fd && \
    rustup default stable && \
    useradd -u 1000 -m slopfile && \
    echo 'slopfile ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/slopfile && \
    chmod 440 /etc/sudoers.d/slopfile && \
    rm -rf /var/cache/pacman/pkg/*
COPY --from=build /build/target/release/slopfile /usr/local/bin/slopfile
USER slopfile
ENTRYPOINT ["/usr/local/bin/slopfile"]
