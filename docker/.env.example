# Copy this file to docker/.env. docker/.env is gitignored, so these selections are personal.
#
# Personal image. The default is docker/Dockerfile.slopfile. After changing this, rebuild the
# image with: docker/run.sh up --build
# SLOPFILE_DOCKERFILE=docker/Dockerfile.slopfile.local
#
# Personal config. This is a full replacement, not an overlay: every non-Option key must be
# present, so a stale file fails at startup instead of silently inheriting a new default.
# The default is /shared/slopfile.toml.
# SLOPFILE_CONFIG=/shared/slopfile.local.toml
#
# Personal llama.cpp model presets. The default is /models/presets.ini.
# LLAMA_PRESETS=/models/presets.local.ini
